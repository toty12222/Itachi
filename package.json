{
  "name": "netprofiles",
  "version": "1.0.0",
  "description": "NetProfiles - Filmes, Séries e TV ao Vivo",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": ".\\scripts\\build-apk.bat",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "streaming",
    "tv",
    "movies",
    "netprofiles"
  ],
  "author": "NetProfiles",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.uzumaki.netprofiles",
    "productName": "NetProfiles",
    "copyright": "Copyright © 2026 NetProfiles",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      ".env",
      "!test/**/*",
      "!scripts/**/*",
      "!scratch/**/*",
      "!dist/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "public/**/*"
    ],
    "win": {
      "icon": "public/netprofiles.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetProfiles"
    }
  }
}
